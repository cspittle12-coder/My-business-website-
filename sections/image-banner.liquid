<div class="hero" {% if section.settings.image %}style="background-image:url({{ section.settings.image | image_url: width: 1800 }});"{% endif %}>
  <div class="hero__content">
    <h1>{{ section.settings.heading | default: 'Shirts made for everyday' }}</h1>
    {% if section.settings.subheading != blank %}
      <p>{{ section.settings.subheading }}</p>
    {% endif %}
    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link | default: '#' }}" class="button">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Image banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shirts made for everyday" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Soft, durable, and built to last." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [
    { "name": "Image banner" }
  ]
}
{% endschema %}

<div class="cart">
  <h1>Your cart</h1>

  {% if cart.item_count == 0 %}
    <p>Your cart is empty. <a href="{{ routes.all_products_collection_url }}">Keep shopping</a>.</p>
  {% else %}
    {% form 'cart', cart %}
      <table class="cart__table">
        <thead>
          <tr>
            <th>Product</th>
            <th>Quantity</th>
            <th>Total</th>
          </tr>
        </thead>
        <tbody>
          {% for item in cart.items %}
            <tr>
              <td>
                <a href="{{ item.url }}">{{ item.product.title }}</a>
                {% unless item.product.has_only_default_variant %}
                  <br><small>{{ item.variant.title }}</small>
                {% endunless %}
              </td>
              <td>
                <input type="number" name="updates[]" value="{{ item.quantity }}" min="0">
              </td>
              <td>{{ item.final_line_price | money }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>

      <p class="cart__subtotal">Subtotal: {{ cart.total_price | money }}</p>
      <button type="submit" name="update">Update cart</button>
      <button type="submit" name="checkout">Checkout</button>
    {% endform %}
  {% endif %}
</div>

{% schema %}
{
  "name": "Main cart",
  "settings": []
}
{% endschema %}
